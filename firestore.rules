rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Empresas e metadados dos documentos podem ser consultados sem login,
    // permitindo navegar pelo catálogo e abrir os PDFs públicos.
    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /documents/{documentId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }
    }

    // Perfis e dados de usuários permanecem privados para usuários autenticados.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
